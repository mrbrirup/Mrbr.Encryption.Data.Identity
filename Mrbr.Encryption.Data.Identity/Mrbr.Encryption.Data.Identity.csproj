<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Mrbr.Encryption.Data.Identity</PackageId>
    <Version>2.0.0</Version>
    <Description>ASP.NET Core Identity integration for source-generated encrypted Entity Framework data.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <MrbrEntityFrameworkProject>..\..\Mrbr.Encryption.Data\Mrbr.Encryption.Data.EntityFramework\Mrbr.Encryption.Data.EntityFramework.csproj</MrbrEntityFrameworkProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Mrbr.Encryption.Data.EntityFramework" Version="2.0.0"
                      Condition="!Exists('$(MrbrEntityFrameworkProject)')" />
    <ProjectReference Include="$(MrbrEntityFrameworkProject)"
                      Condition="Exists('$(MrbrEntityFrameworkProject)')" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\docs\identity-entity-security-audit.md" Pack="true" PackagePath="docs\" Link="docs\identity-entity-security-audit.md" />
    <None Include="..\docs\identity-token-security-design.md" Pack="true" PackagePath="docs\" Link="docs\identity-token-security-design.md" />
    <None Include="..\docs\identity-token-migration-design.md" Pack="true" PackagePath="docs\" Link="docs\identity-token-migration-design.md" />
    <None Include="..\docs\performance-baseline.md" Pack="true" PackagePath="docs\" Link="docs\performance-baseline.md" />
  </ItemGroup>
</Project>
